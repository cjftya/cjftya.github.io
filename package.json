{
  "name": "jelly-plants",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:landmark": "node scripts/landmark-browser-qa.mjs",
    "qa:cliff": "node scripts/cliff-detail-browser-qa.mjs",
    "qa:ruin-night": "node scripts/ruin-night-browser-qa.mjs",
    "archive:check": "node scripts/check-artifact-archive.mjs",
    "data:update": "node scripts/update-uriel-data.mjs",
    "data:check": "node scripts/update-uriel-data.mjs --check",
    "research:shape": "node scripts/shape7x7-study.mjs",
    "build": "tsc --noEmit && vite build && node scripts/copy-legacy.mjs",
    "preview": "vite preview",
    "wedding:check": "node scripts/weddingcard/check.mjs",
    "wedding:rotate": "node scripts/weddingcard/migrate.mjs rotate",
    "wedding:verify": "node scripts/weddingcard/migrate.mjs verify"
  },
  "dependencies": {
    "pixi.js": "8.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "0.185.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "26.1.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
